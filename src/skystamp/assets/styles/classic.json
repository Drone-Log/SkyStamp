    {"type": "info", "x": 1, "y": 0, "anchor": "tr", "size": 30, "items": ["camera"], "direction": "column"},
    {"type": "speedbox", "x": 0.5, "y": 1, "anchor": "b", "size": 56, "field": "speed"},
    {"type": "info", "x": 0, "y": 1, "anchor": "bl", "size": 26, "items": ["gps", "coords"]},
    {"type": "info", "x": 1, "y": 1, "anchor": "br", "size": 26, "items": ["time"]}
  ]
}
