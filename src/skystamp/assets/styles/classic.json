{
  "format": 1,
  "name": "Classic",
  "description": "Flight data top-left, camera top-right, speed box at the bottom, GPS and time in the corners.",
  "elements": [
    {"type": "data", "x": 0, "y": 0, "anchor": "tl", "size": 30, "direction": "column", "labels": "prefix",
